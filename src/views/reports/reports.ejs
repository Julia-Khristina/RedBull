<%#
  VIEW: reports/reports.ejs
  ESTADO: [C1 - Conectado]
  ENDPOINTS CONSUMIDOS:
    - GET /reports                                  [A1][B1] rota curta usada pelo menu
    - GET /view/competitions/:id/reports            [A1][B1] rota SSR por competicao
    - GET /competitions/:id/reports                 [A1][B1] JSON do relatorio
    - GET /competitions/:id/export                  [A1][B1] exportacao
  LACUNAS:
    - Quando nao ha competition_report no banco, a tela renderiza estado vazio sem quebrar. [D1]
%>

<%
  const safeHighlights = highlights && typeof highlights === 'object' ? highlights : null;
  const summary = safeHighlights && safeHighlights.summary && typeof safeHighlights.summary === 'object'
    ? safeHighlights.summary
    : {};
  const reportHighlights = safeHighlights && safeHighlights.highlights && typeof safeHighlights.highlights === 'object'
    ? safeHighlights.highlights
    : {};

  function pickValue(source, keys, fallback) {
    for (const key of keys) {
      if (
        Object.prototype.hasOwnProperty.call(source, key) &&
        source[key] !== null &&
        source[key] !== undefined &&
        source[key] !== ''
      ) {
        return source[key];
      }
    }
    return fallback;
  }

  function formatDateTime(value) {
    if (!value) return '-';
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return String(value);
    return parsed.toLocaleString('pt-BR');
  }

  const totalKm = pickValue(summary, ['total_km', 'km_total', 'totalKm'], null);
  const avgPace = pickValue(summary, ['avg_pace', 'avgPace', 'pace_medio'], null);
  const checkpointCount = pickValue(summary, ['checkpoint_count', 'checkpointCount', 'total_checkpoints'], null);
  const teamCount = pickValue(summary, ['team_count', 'teamCount', 'total_equipes'], null);
  const athleteCount = pickValue(summary, ['athlete_count', 'athleteCount', 'total_atletas'], null);
  const generatedAt = safeHighlights ? safeHighlights.generated_at : null;
  const topTeams = Array.isArray(reportHighlights.top_teams) ? reportHighlights.top_teams : [];
  const topAthletes = Array.isArray(reportHighlights.top_athletes) ? reportHighlights.top_athletes : [];
  const reportText = typeof reportHighlights.report_text === 'string' ? reportHighlights.report_text : '';
%>

<main class="ranking-page reports-page">
  <div class="ranking-topbar">
    <div class="ranking-topbar-left">
      <span class="ranking-competition-label"><%= competition.name %></span>
    </div>
  </div>

  <h1 class="ranking-main-title">Relatorios</h1>

  <div class="stat-cards">
    <div class="stat-card">
      <span class="stat-label">Total de km percorridos</span>
      <span class="stat-value"><%= totalKm !== null ? totalKm : '—' %></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Pace medio geral</span>
      <span class="stat-value"><%= avgPace !== null ? avgPace : '—' %></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Checkpoints</span>
      <span class="stat-value"><%= checkpointCount !== null ? checkpointCount : '—' %></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Equipes</span>
      <span class="stat-value"><%= teamCount !== null ? teamCount : '—' %></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Atletas</span>
      <span class="stat-value"><%= athleteCount !== null ? athleteCount : '—' %></span>
    </div>
  </div>

  <section class="live-section">
    <h2 class="section-title">Dados do relatorio</h2>

    <% if (!safeHighlights) { %>
      <div class="empty-state">
        <p>Nenhum relatorio gerado para esta competicao ainda.</p>
      </div>
    <% } else { %>
      <div class="team-card">
        <div class="team-card-body">
          <div class="team-name-row">
            <span class="team-name">Relatorio da competicao</span>
            <% if (generatedAt) { %>
              <span class="leader-pill">Gerado em <%= formatDateTime(generatedAt) %></span>
            <% } %>
          </div>
          <div class="team-stats-row">
            <div class="team-stat">
              <span class="team-stat-label">Competicao</span>
              <span class="team-stat-value"><%= competition.name %></span>
            </div>
            <div class="team-stat">
              <span class="team-stat-label">Status</span>
              <span class="team-stat-value"><%= competition.status %></span>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </section>

  <% if (reportText) { %>
    <section class="live-section">
      <h2 class="section-title">Highlights</h2>
      <div class="team-card">
        <p><%= reportText %></p>
      </div>
    </section>
  <% } %>

  <% if (topTeams.length > 0 || topAthletes.length > 0) { %>
    <section class="runners-section">
      <h2 class="section-title">Destaques</h2>
      <div class="runners-grid">
        <% topTeams.forEach(function(team) { %>
          <div class="runner-card">
            <div class="runner-card-top">
              <div class="runner-identity">
                <span class="runner-name"><%= team.name || team.team_name || 'Equipe' %></span>
                <span class="runner-team">Equipe destaque</span>
              </div>
            </div>
          </div>
        <% }); %>
        <% topAthletes.forEach(function(athlete) { %>
          <div class="runner-card">
            <div class="runner-card-top">
              <div class="runner-identity">
                <span class="runner-name"><%= athlete.name || athlete.runner_name || 'Atleta' %></span>
                <span class="runner-team">Atleta destaque</span>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>

  <section class="live-section">
    <h2 class="section-title">Endpoints conectados</h2>
    <div class="team-card">
      <div class="teams__card-actions">
        <a class="teams__access-btn" href="/competitions/<%= competition.id %>/export">
          Exportar dados
        </a>
        <a class="teams__edit-btn" href="/competitions/<%= competition.id %>/reports">
          Ver JSON do relatorio
        </a>
      </div>
    </div>
  </section>
</main>
