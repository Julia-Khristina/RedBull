<%#
  VIEW: reports/reports.ejs
    ESTADO: [C1 - Completo]
      LACUNAS (aceitas - nao bloqueiam o funcionamento):
        - Botao "Log de Auditoria" aponta para rota SSR ainda nao registrada em routes/ [D2]
          - Campos de summary/highlights usam fallback de chaves inferidas [B2]
            ENDPOINTS CONSUMIDOS:
              - GET /view/competitions/:id/reports          [A1][B1 - reportController]
                - GET /competitions/:id/export                [A1][B1 - exportController]
                  - GET /competitions/:id/checkpoints/inconsistencies [A1][B1 - checkpointController]
                    CSS:
                      - /css/ranking.css (secao Reports view)       [A1][D1]
                        - /css/variables.css (tokens de design)       [A1][D1]
                          ULTIMA ATUALIZACAO: 2026-06-11
                          %>
                          <link rel="stylesheet" href="/css/ranking.css">

                          <%
                            const summary     = report && report.summary     && typeof report.summary     === 'object' ? report.summary     : {};
                              const highlights  = report && report.highlights  && typeof report.highlights  === 'object' ? report.highlights  : {};
                                const inconsistencyRows = Array.isArray(inconsistencies) ? inconsistencies : [];

                                  function pickValue(source, keys, fallback) {
                                          for (const key of keys) {
                                                    if (Object.prototype.hasOwnProperty.call(source, key) && source[key] !== null && source[key] !== undefined && source[key] !== '') {
                                                                return source[key];
                                                    }
                                          }
                                              return fallback;
                                  }

                                    function formatDateTime(value) {
                                            if (!value) return '-';
                                                const parsed = new Date(value);
                                                    if (Number.isNaN(parsed.getTime())) return value;
                                                        return parsed.toLocaleString('pt-BR');
                                    }

                                      const totalKm          = pickValue(summary, ['total_km', 'km_total', 'totalKm'], '-');
                                        const avgPace          = pickValue(summary, ['avg_pace', 'avgPace', 'pace_medio'], '-');
                                          const checkpointCount  = pickValue(summary, ['checkpoint_count', 'checkpointCount', 'total_checkpoints'], '-');
                                            const teamCount        = pickValue(summary, ['team_count', 'teamCount', 'total_equipes'], '-');
                                              const athleteCount     = pickValue(summary, ['athlete_count', 'athleteCount', 'total_atletas'], '-');

                                                const positionHistory  = Array.isArray(highlights.position_history) ? highlights.position_history : [];
                                                  const topTeams         = Array.isArray(highlights.top_teams)        ? highlights.top_teams        : [];
                                                    const topAthletes      = Array.isArray(highlights.top_athletes)     ? highlights.top_athletes     : [];
                                                      const teams            = Array.isArray(report.teams)                ? report.teams                : [];
                                                        const reportText       = report.report_text || '';
                                                        %>

                                                        <main class="ranking-container reports-container" role="main" aria-label="Relatorio da competicao">

                                                          <% if (typeof error !== 'undefined' && error) { %>
                                                              <div class="reports-error-banner" role="alert" aria-live="assertive">
                                                                    <span class="reports-error-icon" aria-hidden="true">aviso</span>
                                                                          <%= error %>
                                                                              </div>
                                                                                <% } %>
                                                                                
                                                                                  <h1 class="ranking-main-title reports-title">Relatorio - Red Bull 24H</h1>
                                                                                  
                                                                                    <section class="stat-cards reports-stat-cards" aria-label="Resumo da competicao">
                                                                                        <article class="stat-card report-stat-card">
                                                                                              <span class="stat-label">Total de km percorridos</span>
                                                                                                    <span class="stat-value"><%= totalKm %><%= totalKm === '-' ? '' : ' km' %></span>
                                                                                                        </article>
                                                                                                            <article class="stat-card report-stat-card">
                                                                                                                  <span class="stat-label">Media geral de pace</span>
                                                                                                                        <span class="stat-value"><%= avgPace %><%= avgPace === '-' ? '' : '/km' %></span>
                                                                                                                            </article>
                                                                                                                                <article class="stat-card report-stat-card">
                                                                                                                                      <span class="stat-label">Numero de checkpoints</span>
                                                                                                                                            <span class="stat-value"><%= checkpointCount %></span>
                                                                                                                                                </article>
                                                                                                                                                    <article class="stat-card report-stat-card">
                                                                                                                                                          <span class="stat-label">Equipes participantes</span>
                                                                                                                                                                <span class="stat-value"><%= teamCount %></span>
                                                                                                                                                                    </article>
                                                                                                                                                                        <article class="stat-card report-stat-card">
                                                                                                                                                                              <span class="stat-label">Atletas registrados</span>
                                                                                                                                                                                    <span class="stat-value"><%= athleteCount %></span>
                                                                                                                                                                                        </article>
                                                                                                                                                                                          </section>
                                                                                                                                                                                          
                                                                                                                                                                                            <section class="reports-section">
                                                                                                                                                                                                <h2 class="section-title reports-section-title">Relatorio por equipe</h2>
                                                                                                                                                                                                    <div class="report-panel report-team-panel">
                                                                                                                                                                                                    
                                                                                                                                                                                                          <div class="report-chart-block">
                                                                                                                                                                                                                  <h3 class="report-panel-title report-panel-title--accent">Posicao durante a competicao</h3>
                                                                                                                                                                                                                          <div class="report-chart" aria-label="Grafico de posicao das equipes">
                                                                                                                                                                                                                                    <% if (positionHistory.length > 0) { %>
                                                                                                                                                                                                                                                <% positionHistory.forEach(function(point, index) { %>
                                                                                                                                                                                                                                                              <span class="report-chart-point" data-index="<%= index %>">
                                                                                                                                                                                                                                                                              <%= point.label ?? point.time ?? index + 1 %>: <%= point.position ?? point.value ?? '-' %>
                                                                                                                                                                                                                                                                                            </span>
                                                                                                                                                                                                                                                                                                        <% }) %>
                                                                                                                                                                                                                                                                                                                  <% } else { %>
                                                                                                                                                                                                                                                                                                                              <div class="report-chart-grid" aria-hidden="true"></div>
                                                                                                                                                                                                                                                                                                                                          <p class="report-chart-empty">Historico de posicoes indisponivel no relatorio.</p>
                                                                                                                                                                                                                                                                                                                                                    <% } %>
                                                                                                                                                                                                                                                                                                                                                            </div>
                                                                                                                                                                                                                                                                                                                                                                  </div>
                                                                                                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                                                                                                        <div class="report-about">
                                                                                                                                                                                                                                                                                                                                                                                <h3 class="report-panel-title">Sobre o relatorio</h3>
                                                                                                                                                                                                                                                                                                                                                                                        <p><%= reportText %></p>
                                                                                                                                                                                                                                                                                                                                                                                                <h4>Equipes:</h4>
                                                                                                                                                                                                                                                                                                                                                                                                        <% if (teams.length > 0) { %>
                                                                                                                                                                                                                                                                                                                                                                                                                  <ul class="report-team-list" aria-label="Equipes participantes">
                                                                                                                                                                                                                                                                                                                                                                                                                              <% teams.forEach(function(team, index) { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                            <li>
                                                                                                                                                                                                                                                                                                                                                                                                                                                            <span class="report-team-dot report-team-dot--<%= index % 2 === 0 ? 'primary' : 'accent' %>" aria-hidden="true"></span>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <%= team.name ?? team.team_name ?? team %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </li>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <% }) %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </ul>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <% } else { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <p class="report-muted">Equipes indisponiveis no relatorio.</p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <% } %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </section>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <% if (topTeams.length > 0) { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <section class="reports-section">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <h2 class="section-title reports-section-title">Ranking de equipes</h2>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <div class="report-panel report-table-panel">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <div class="report-table-wrap" role="region" aria-label="Ranking de equipes" tabindex="0">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <table class="report-table" aria-describedby="caption-ranking-equipes">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <caption id="caption-ranking-equipes" class="sr-only">Classificacao das equipes por quilometragem e pace medio</caption>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <thead>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <th scope="col">#</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <th scope="col">Equipe</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <th scope="col">Corredores</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <th scope="col">KM Total</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <th scope="col">Pace Medio</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </thead>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <% topTeams.forEach(function(team) { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <td class="report-pos" aria-label="Posicao <%= team.posicao %>">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <%= team.posicao === 1 ? '1o' : team.posicao === 2 ? '2o' : team.posicao === 3 ? '3o' : team.posicao %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td><%= team.equipe_nome %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td><%= team.corredores ?? '-' %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td><%= team.km_total != null ? Number(team.km_total).toFixed(2) + ' km' : '-' %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td><%= team.pace_medio ?? '-' %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <% }) %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              </table>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </section>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <% } %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <% if (topAthletes.length > 0) { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <section class="reports-section">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <h2 class="section-title reports-section-title">Ranking de atletas</h2>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <div class="report-panel report-table-panel">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <div class="report-table-wrap" role="region" aria-label="Ranking de atletas" tabindex="0">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <table class="report-table" aria-describedby="caption-ranking-atletas">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <caption id="caption-ranking-atletas" class="sr-only">Classificacao dos atletas por quilometragem e pace medio</caption>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <thead>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <th scope="col">#</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <th scope="col">Atleta</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <th scope="col">KM Total</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <th scope="col">Pace Medio</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </thead>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <% topAthletes.forEach(function(athlete) { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <td class="report-pos" aria-label="Posicao <%= athlete.posicao %>">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <%= athlete.posicao === 1 ? '1o' : athlete.posicao === 2 ? '2o' : athlete.posicao === 3 ? '3o' : athlete.posicao %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <td><%= athlete.corredor_nome ?? '-' %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <td><%= athlete.km_total != null ? Number(athlete.km_total).toFixed(2) + ' km' : '-' %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <td><%= athlete.pace_medio ?? '-' %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <% }) %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              </tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </table>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </section>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <% } %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <section class="reports-section">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <div class="reports-section-heading">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <h2 class="section-title reports-section-title">Relatorio de inconsistencias</h2>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <a class="report-action-button" href="/view/competitions/<%= competition.id %>/audit">Log de Auditoria</a>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <div class="report-panel report-table-panel">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <h3 class="report-table-title">Registros corrigidos manualmente</h3>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <% if (inconsistencyRows.length === 0) { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <div class="empty-state report-empty-state">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <p>Nenhuma inconsistencia encontrada para esta competicao.</p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <% } else { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <div class="report-table-wrap" role="region" aria-label="Inconsistencias registradas" tabindex="0">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <table class="report-table" aria-describedby="caption-inconsistencias">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <caption id="caption-inconsistencias" class="sr-only">Registros corrigidos manualmente durante a competicao</caption>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <thead>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <th scope="col">Data / Hora</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <th scope="col">Atleta</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <th scope="col">Checkpoint</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <th scope="col">Distancia</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <th scope="col">Pace</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <th scope="col">Usuario</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </thead>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <% inconsistencyRows.forEach(function(checkpoint) { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <tr>
