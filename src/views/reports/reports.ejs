<%#
  VIEW: reports/reports.ejs
    ESTADO: [C1 - Completo]
      ISSUES: #341 (ST-01 estrutura/layout) | #344 (ST-02 integracao endpoint)
        LACUNAS (aceitas - nao bloqueiam o funcionamento):
          - Rota SSR /view/competitions/:id/audit ainda nao registrada em routes/ [D2]
            - highlights usa fallback por chaves inferidas do model competition_report [B2]
              ENDPOINTS CONSUMIDOS:
                - GET /view/competitions/:id/reports  [A1][B1 - reportController.renderReports]
                  - GET /competitions/:id/export        [A1][B1 - exportController]  RN15
                    - GET /competitions/:id/reports       [A1][B1 - reportController.generateCompetitionReport] RN16/RN17
                      CSS:
                        - /css/variables.css  [A1][D1]
                          - /css/menu.css       [A1][D1]
                            SHAPE MINIMO (agent.md Secao 11):
                              - competition: { id, name, status }
                                - highlights: { summary, generated_at } | null
                                  - currentPage: 'reports'
                                    REGRAS DE NEGOCIO:
                                      - RN15: link de exportacao CSV aponta para GET /competitions/:id/export
                                        - RN16/RN17: highlights pos-evento gerados ao encerrar - exibir quando disponiveis
                                          ULTIMA ATUALIZACAO: 2026-06-11
                                          %>
                                          <%- include('../layouts/main', { title: title }) %>
                                          <%- include('../partials/menu', { currentPage: currentPage }) %>
                                          
                                          <%
                                            // [A1][B1] highlights vem de reportController.renderReports via reportService.generateCompetitionReport
                                              // Shape verificado em src/models/report.ts: { id_competition, summary, highlights, generated_at }
                                                const safeHighlights = highlights && typeof highlights === 'object' ? highlights : {};
                                                  const summary        = safeHighlights.summary     && typeof safeHighlights.summary     === 'object' ? safeHighlights.summary     : {};
                                                    const generatedAt    = safeHighlights.generated_at ?? null;
                                                    
                                                      // [A1][B2] Campos de summary inferidos do model competition_report (Record<string, unknown>)
                                                        // Verificar src/repositories/reportRepository.ts antes do PR de ST-02 (#344)
                                                          function pickValue(source, keys, fallback) {
                                                                for (const key of keys) {
                                                                        if (Object.prototype.hasOwnProperty.call(source, key) &&
                                                                                  source[key] !== null && source[key] !== undefined && source[key] !== '') {
                                                                                            return source[key];
                                                                                  }
                                                                }
                                                                    return fallback;
                                                          }

                                                            function formatDateTime(value) {
                                                                  if (!value) return '-';
                                                                      const parsed = new Date(value);
                                                                          if (Number.isNaN(parsed.getTime())) return String(value);
                                                                              return parsed.toLocaleString('pt-BR');
                                                            }

                                                              const totalKm         = pickValue(summary, ['total_km', 'km_total', 'totalKm'], null);
                                                                const avgPace         = pickValue(summary, ['avg_pace', 'avgPace', 'pace_medio'], null);
                                                                  const checkpointCount = pickValue(summary, ['checkpoint_count', 'checkpointCount', 'total_checkpoints'], null);
                                                                    const teamCount       = pickValue(summary, ['team_count', 'teamCount', 'total_equipes'], null);
                                                                      const athleteCount    = pickValue(summary, ['athlete_count', 'athleteCount', 'total_atletas'], null);

                                                                        // [A1][B2] Highlights pos-evento - RN16/RN17
                                                                          const positionHistory = Array.isArray(safeHighlights.position_history) ? safeHighlights.position_history : [];
                                                                            const topTeams        = Array.isArray(safeHighlights.top_teams)        ? safeHighlights.top_teams        : [];
                                                                              const topAthletes     = Array.isArray(safeHighlights.top_athletes)     ? safeHighlights.top_athletes     : [];
                                                                                const reportTeams     = Array.isArray(safeHighlights.teams)            ? safeHighlights.teams            : [];
                                                                                  const reportText      = typeof safeHighlights.report_text === 'string' ? safeHighlights.report_text      : '';
                                                                                  %>

                                                                                  <main class="content reports-container" role="main" aria-label="Relatorio da competicao <%= competition.name %>">

                                                                                    <%# ── ERRO ──────────────────────────────────────────────────── %>
                                                                                      <% if (locals.error) { %>
                                                                                          <div class="alert alert-error" role="alert" aria-live="assertive">
                                                                                                <%= error %>
                                                                                                    </div>
                                                                                                      <% } %>
                                                                                                      
                                                                                                        <%# ── CABECALHO ──────────────────────────────────────────────── %>
                                                                                                          <section class="page-header reports-header">
                                                                                                              <h1 class="page-title">Relatorio — Red Bull 24h</h1>
                                                                                                                  <p class="reports-competition-name"><%= competition.name %></p>
                                                                                                                      <% if (generatedAt) { %>
                                                                                                                            <p class="reports-generated-at">
                                                                                                                                    <span class="label-text">Gerado em:</span>
                                                                                                                                            <time datetime="<%= generatedAt %>"><%= formatDateTime(generatedAt) %></time>
                                                                                                                                                  </p>
                                                                                                                                                      <% } %>
                                                                                                                                                        </section>
                                                                                                                                                        
                                                                                                                                                          <%# ── STAT CARDS (RN15/RN16/RN17) ──────────────────────────── %>
                                                                                                                                                            <section class="stat-cards reports-stat-cards" aria-label="Resumo da competicao">
                                                                                                                                                            
                                                                                                                                                                <article class="stat-card" aria-label="Total de km percorridos: <%= totalKm !== null ? totalKm + ' km' : 'indisponivel' %>">
                                                                                                                                                                      <span class="stat-label">Total de km percorridos</span>
                                                                                                                                                                            <span class="stat-value">
                                                                                                                                                                                    <% if (totalKm !== null) { %><%= totalKm %> <small>km</small><% } else { %>-<% } %>
                                                                                                                                                                                          </span>
                                                                                                                                                                                              </article>
                                                                                                                                                                                              
                                                                                                                                                                                                  <article class="stat-card" aria-label="Media geral de pace: <%= avgPace !== null ? avgPace + '/km' : 'indisponivel' %>">
                                                                                                                                                                                                        <span class="stat-label">Media geral de pace</span>
                                                                                                                                                                                                              <span class="stat-value">
                                                                                                                                                                                                                      <% if (avgPace !== null) { %><%= avgPace %> <small>/km</small><% } else { %>-<% } %>
                                                                                                                                                                                                                            </span>
                                                                                                                                                                                                                                </article>
                                                                                                                                                                                                                                
                                                                                                                                                                                                                                    <article class="stat-card" aria-label="Checkpoints registrados: <%= checkpointCount !== null ? checkpointCount : 'indisponivel' %>">
                                                                                                                                                                                                                                          <span class="stat-label">Checkpoints registrados</span>
                                                                                                                                                                                                                                                <span class="stat-value"><%= checkpointCount !== null ? checkpointCount : '-' %></span>
                                                                                                                                                                                                                                                    </article>
                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                        <article class="stat-card" aria-label="Equipes participantes: <%= teamCount !== null ? teamCount : 'indisponivel' %>">
                                                                                                                                                                                                                                                              <span class="stat-label">Equipes participantes</span>
                                                                                                                                                                                                                                                                    <span class="stat-value"><%= teamCount !== null ? teamCount : '-' %></span>
                                                                                                                                                                                                                                                                        </article>
                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                            <article class="stat-card" aria-label="Atletas registrados: <%= athleteCount !== null ? athleteCount : 'indisponivel' %>">
                                                                                                                                                                                                                                                                                  <span class="stat-label">Atletas registrados</span>
                                                                                                                                                                                                                                                                                        <span class="stat-value"><%= athleteCount !== null ? athleteCount : '-' %></span>
                                                                                                                                                                                                                                                                                            </article>
                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                              </section>
                                                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                                <%# ── HIGHLIGHTS (RN16/RN17 - so exibe quando competition.status === 'encerrada') ── %>
                                                                                                                                                                                                                                                                                                  <% if (competition.status === 'encerrada' && highlights) { %>
                                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                                      <%# Ranking de equipes %>
                                                                                                                                                                                                                                                                                                          <% if (topTeams.length > 0) { %>
                                                                                                                                                                                                                                                                                                              <section class="reports-section" aria-labelledby="titulo-ranking-equipes">
                                                                                                                                                                                                                                                                                                                    <h2 id="titulo-ranking-equipes" class="section-title">Ranking de equipes</h2>
                                                                                                                                                                                                                                                                                                                          <div class="table-responsive" role="region" aria-labelledby="titulo-ranking-equipes" tabindex="0">
                                                                                                                                                                                                                                                                                                                                  <table class="data-table">
                                                                                                                                                                                                                                                                                                                                            <caption class="sr-only">Classificacao final das equipes por quilometragem e pace medio</caption>
                                                                                                                                                                                                                                                                                                                                                      <thead>
                                                                                                                                                                                                                                                                                                                                                                  <tr>
                                                                                                                                                                                                                                                                                                                                                                                <th scope="col" abbr="Posicao">#</th>
                                                                                                                                                                                                                                                                                                                                                                                              <th scope="col">Equipe</th>
                                                                                                                                                                                                                                                                                                                                                                                                            <th scope="col">Corredores</th>
                                                                                                                                                                                                                                                                                                                                                                                                                          <th scope="col">KM Total</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                        <th scope="col">Pace Medio</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                    </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                              </thead>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <% topTeams.forEach(function(team) { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td aria-label="Posicao <%= team.posicao %>"><%= team.posicao %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td><%= team.equipe_nome %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td><%= team.corredores != null ? team.corredores : '-' %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td><%= team.km_total != null ? Number(team.km_total).toFixed(2) + ' km' : '-' %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <td><%= team.pace_medio != null ? team.pace_medio : '-' %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <% }) %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              </table>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </section>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <% } %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <%# Ranking de atletas %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <% if (topAthletes.length > 0) { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <section class="reports-section" aria-labelledby="titulo-ranking-atletas">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <h2 id="titulo-ranking-atletas" class="section-title">Ranking de atletas</h2>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <div class="table-responsive" role="region" aria-labelledby="titulo-ranking-atletas" tabindex="0">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <table class="data-table">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <caption class="sr-only">Classificacao final dos atletas por quilometragem e pace medio</caption>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <thead>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <th scope="col" abbr="Posicao">#</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <th scope="col">Atleta</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <th scope="col">KM Total</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <th scope="col">Pace Medio</th>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </thead>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <% topAthletes.forEach(function(athlete) { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <td aria-label="Posicao <%= athlete.posicao %>"><%= athlete.posicao %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <td><%= athlete.corredor_nome != null ? athlete.corredor_nome : '-' %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <td><%= athlete.km_total != null ? Number(athlete.km_total).toFixed(2) + ' km' : '-' %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <td><%= athlete.pace_medio != null ? athlete.pace_medio : '-' %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <% }) %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </table>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </section>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <% } %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <% } else if (competition.status !== 'encerrada') { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <%# Estado: competicao ainda em andamento - RN16/RN17 %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <section class="reports-section reports-pending" aria-label="Relatorio indisponivel">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <div class="empty-state">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <p>O relatorio detalhado sera gerado automaticamente ao encerrar a competicao.</p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </section>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <% } %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <%# ── EXPORTACAO CSV (RN15) ──────────────────────────────────── %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <section class="reports-section reports-export" aria-labelledby="titulo-exportacao">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <h2 id="titulo-exportacao" class="section-title">Exportar dados</h2>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <p class="reports-export-desc">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              Exporta todos os checkpoints, timestamps e logs de validacao da competicao em formato JSON.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <%# [A1][B1] RN15: GET /competitions/:id/export %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <a
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                class="btn btn-primary"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      href="/competitions/<%= competition.id %>/export"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            aria-label="Exportar dados completos da competicao <%= competition.name %>"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                >
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      Exportar dados
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </a>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </section>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <%# ── LOG DE AUDITORIA ───────────────────────────────────────── %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <%# [D2] Rota SSR /view/competitions/:id/audit documentada no agent.md Secao 11 mas ainda nao registrada em routes/ %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <section class="reports-section" aria-labelledby="titulo-auditoria">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <h2 id="titulo-auditoria" class="section-title">Auditoria</h2>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <a
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                class="btn btn-secondary"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      href="/view/competitions/<%= competition.id %>/audit"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            aria-label="Acessar log de auditoria da competicao <%= competition.name %>"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                >
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      Ver Log de Auditoria
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </a>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </section>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </main>}})}})}}}}
                                                            }
                                                                                  })
                                                                }
                                                          }>